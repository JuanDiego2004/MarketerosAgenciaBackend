# Añadir al .env local del backend. No subir credenciales al repositorio.
# WhatsApp Cloud: número registrado y plantilla de texto con parámetros posicionales aprobada.
CRM_WHATSAPP_TOKEN=
CRM_WHATSAPP_PHONE_ID=
# Secreto de la app Meta que recibe los webhooks; no es el token de acceso.
CRM_WHATSAPP_APP_SECRET=
# Cadena aleatoria propia de 32 a 256 caracteres, igual a Verify token en Meta.
CRM_WHATSAPP_VERIFY_TOKEN=
# Brevo requiere una clave API (formato xkeysib-...), no una SMTP key.
BREVO_API_KEY=
# Debe coincidir con un remitente verificado en Brevo.
CRM_SMTP_FROM=
# Logo HTTPS accesible por los destinatarios; por defecto se usa el logo de Marketeros.
CRM_EMAIL_LOGO_URL=https://marketerosfrontend.onrender.com/email-logo.svg
# Dirección HTTPS pública del backend, usada por los enlaces de baja.
CRM_PUBLIC_URL=

# Activar solo después de revisar flujos y probar Brevo con un destinatario autorizado.
CRM_AUTOMATIZACIONES_HABILITADAS=false

# Publicidad simulada: no utiliza cuentas ni tokens de Meta/TikTok/YouTube.
CRM_MOCKAROO_HABILITADO=true
# Clave privada de Mockaroo. No colocar en variables VITE_*.
CRM_MOCKAROO_API_KEY=
CRM_WHATSAPP_VERSION=v27.0
