# Añadir al .env local del backend. No subir credenciales al repositorio.
CRM_META_TOKEN=
CRM_META_VERSION=v27.0
# OAuth con scopes adwords y analytics.readonly; usuario con acceso a cuenta/propiedad.
CRM_GOOGLE_CLIENT_ID=
CRM_GOOGLE_CLIENT_SECRET=
CRM_GOOGLE_REFRESH_TOKEN=
# Legado opcional: Google trasladó los niveles de acceso al proyecto Cloud.
# Para altas nuevas dejar vacío; no se requiere developer token.
CRM_GOOGLE_ADS_DEVELOPER_TOKEN=
# Opcional: ID de cuenta administradora sin guiones.
CRM_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
CRM_GOOGLE_ADS_VERSION=v26
# WhatsApp Cloud: número registrado y plantilla de texto con parámetros posicionales aprobada.
CRM_WHATSAPP_TOKEN=
CRM_WHATSAPP_PHONE_ID=
# Secreto de la app Meta que recibe los webhooks; no es el token de acceso.
CRM_WHATSAPP_APP_SECRET=
# Cadena aleatoria propia de 32 a 256 caracteres, igual a Verify token en Meta.
CRM_WHATSAPP_VERIFY_TOKEN=
# Twilio: número SMS habilitado, con prefijo + de país.
CRM_TWILIO_ACCOUNT_SID=
CRM_TWILIO_AUTH_TOKEN=
CRM_TWILIO_FROM=
CRM_SMTP_FROM=
# Dirección HTTPS pública del backend, usada por los enlaces de baja.
CRM_PUBLIC_URL=
# Solo true cuando el proveedor firma con DKIM List-Unsubscribe y List-Unsubscribe-Post.
CRM_SMTP_ONE_CLICK=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Activar solo después de revisar flujos y probar SMTP con un destinatario autorizado.
CRM_AUTOMATIZACIONES_HABILITADAS=false

# Publicidad simulada: no utiliza cuentas ni tokens de Meta/TikTok/YouTube.
CRM_MOCKAROO_HABILITADO=true
# Clave privada de Mockaroo. No colocar en variables VITE_*.
CRM_MOCKAROO_API_KEY=
